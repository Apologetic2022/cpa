ADAPTER_LISTEN=unix:///run/relay/agent-claude-account.sock
CLAUDE_BIN=/opt/cli-proxy/bin/claude
PERSONA_CWD=/opt/cli-proxy/agents/workspace
CLAUDE_CONFIG_DIR=/opt/cli-proxy/agents/claude-account.claude-config
# Residential egress for THIS account agent (docs ch.4: provenance consistency).
# Adapter env allowlist (6.4) passes these to the claude child; gateway never reads this file.
# Residential egress for THIS account agent (docs ch.4: provenance consistency).
# Adapter env allowlist (6.4) passes these to the claude child; gateway never reads this file.
HTTPS_PROXY=http://REDACTED_PROXY_USER:REDACTED_PROXY_PASS@isp.oxylabs.io:8006
https_proxy=http://REDACTED_PROXY_USER:REDACTED_PROXY_PASS@isp.oxylabs.io:8006
HTTP_PROXY=http://REDACTED_PROXY_USER:REDACTED_PROXY_PASS@isp.oxylabs.io:8006
http_proxy=http://REDACTED_PROXY_USER:REDACTED_PROXY_PASS@isp.oxylabs.io:8006
CLAUDE_CODE_OAUTH_TOKEN=REDACTED_CLAUDE_OAUTH_TOKEN
