# Trusted-certificate entry points for the same gateway.
#
# The default 443 vhost still serves the self-signed certificate for the bare
# IP, which chat clients refuse when they fetch a generated image
# (DEPTH_ZERO_SELF_SIGNED_CERT). Both names below resolve to this host through
# sslip.io's wildcard DNS, so Let's Encrypt can issue for them and any client
# trusts the result.
#
# 0fcc5ed6.sslip.io is the address generated images are handed out under. It is
# the same host written in hex, which keeps the address out of the reply text:
# an image link is the only form a hardened markdown renderer will display, so
# the name is going to be in the transcript whether or not it reads as an IP.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name 0fcc5ed6.sslip.io;
    client_max_body_size 50m;

    ssl_certificate     /etc/letsencrypt/live/0fcc5ed6.sslip.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/0fcc5ed6.sslip.io/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8317;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
    }
}

# Kept so links handed out under the older name keep resolving for their
