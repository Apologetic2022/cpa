# Trusted-certificate entry point for the same gateway.
#
# The default 443 vhost still serves the self-signed certificate for the bare
# IP, which chat clients refuse when they fetch a generated image
# (DEPTH_ZERO_SELF_SIGNED_CERT). 15-204-94-214.sslip.io resolves to this host,
# so Let's Encrypt can issue for it and any client trusts the result.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name 15-204-94-214.sslip.io;
    client_max_body_size 50m;

    ssl_certificate     /etc/letsencrypt/live/15-204-94-214.sslip.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/15-204-94-214.sslip.io/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8317;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
    }
}
