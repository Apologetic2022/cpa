[Unit]
Description=CLIProxyAPI Mode-B relay gateway (control plane; never contacts Anthropic)
After=network-online.target relay-egress-guard.service
Wants=network-online.target
Requires=relay-egress-guard.service

[Service]
Type=simple
# Docs 6.6.2 host defense: the gateway runs as a dedicated unprivileged user; the
# kernel drops ALL of its non-loopback egress (see relay-egress-guard.service), so even
# a code regression cannot open a socket to Anthropic.
User=cliproxy
SupplementaryGroups=relay
WorkingDirectory=/opt/cli-proxy
ExecStart=/opt/cli-proxy/bin/cli-proxy-api -config /opt/cli-proxy/config.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/cli-proxy

[Install]
WantedBy=multi-user.target
